<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.live.mapper.LiveUploadMapper">

    <resultMap type="LiveUpload" id="LiveUploadResult">
        <id     property="uploadId"     column="upload_id"/>
        <result property="bizDate"      column="biz_date"/>
        <result property="streamerId"   column="streamer_id"/>
        <result property="stageName"    column="stage_name"/>
        <result property="uploadType"   column="upload_type"/>
        <result property="filePath"     column="file_path"/>
        <result property="rawText"      column="raw_text"/>
        <result property="aiStatus"     column="ai_status"/>
        <result property="aiResult"     column="ai_result"/>
        <result property="uploadBy"     column="upload_by"/>
        <result property="uploadByName" column="upload_by_name"/>
        <result property="createTime"   column="create_time"/>
        <result property="updateTime"   column="update_time"/>
    </resultMap>

    <sql id="selectUploadVo">
        select u.upload_id, u.biz_date, u.streamer_id, s.stage_name, u.upload_type, u.file_path,
               u.raw_text, u.ai_status, u.ai_result, u.upload_by, su.nick_name as upload_by_name,
               u.create_time, u.update_time
        from live_upload u
        left join live_streamer s on s.streamer_id = u.streamer_id
        left join sys_user su on su.user_id = u.upload_by
    </sql>

    <sql id="listWhere">
        <where>
            <if test="beginDate != null and beginDate != ''">
                and u.biz_date &gt;= #{beginDate}
            </if>
            <if test="endDate != null and endDate != ''">
                and u.biz_date &lt;= #{endDate}
            </if>
            <if test="streamerId != null">
                and u.streamer_id = #{streamerId}
            </if>
            <if test="uploadType != null and uploadType != ''">
                and u.upload_type = #{uploadType}
            </if>
            <if test="aiStatus != null and aiStatus != ''">
                and u.ai_status = #{aiStatus}
            </if>
        </where>
    </sql>

    <select id="selectLiveUploadList" parameterType="LiveUpload" resultMap="LiveUploadResult">
        <include refid="selectUploadVo"/>
        <include refid="listWhere"/>
        order by u.biz_date desc, u.upload_id desc
    </select>

    <select id="selectLiveUploadById" parameterType="Long" resultMap="LiveUploadResult">
        <include refid="selectUploadVo"/>
        where u.upload_id = #{uploadId}
    </select>

    <select id="selectLiveUploadByIds" resultMap="LiveUploadResult">
        <include refid="selectUploadVo"/>
        where u.upload_id in
        <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>

    <select id="selectDailySummary" parameterType="LiveUpload" resultType="com.ruoyi.live.domain.LiveDailySummary">
        select date_format(u.biz_date, '%Y-%m-%d') as bizDate,
               u.streamer_id as streamerId,
               s.stage_name as stageName,
               sum(case when u.upload_type = '1' then 1 else 0 end) as giftCount,
               sum(case when u.upload_type = '2' then 1 else 0 end) as chatCount,
               sum(case when u.upload_type = '3' then 1 else 0 end) as reportCount
        from live_upload u
        left join live_streamer s on s.streamer_id = u.streamer_id
        <include refid="listWhere"/>
        group by u.biz_date, u.streamer_id, s.stage_name
        order by u.biz_date desc, u.streamer_id
    </select>

    <insert id="insertLiveUpload" parameterType="LiveUpload" useGeneratedKeys="true" keyProperty="uploadId">
        insert into live_upload (biz_date, streamer_id, upload_type, file_path, raw_text, ai_status, upload_by, create_time)
        values (#{bizDate}, #{streamerId}, #{uploadType}, #{filePath}, #{rawText}, '0', #{uploadBy}, sysdate())
    </insert>

    <delete id="deleteLiveUploadByIds">
        delete from live_upload where upload_id in
        <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>

</mapper>
